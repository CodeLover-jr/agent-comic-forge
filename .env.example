# ============================================================================
# AI漫剧一键生成平台 - 密钥模板（阿里云百炼 Model Studio / DashScope）
# 使用方法：复制本文件为 .env，填入 API-KEY。不要提交 .env 到 Git。
# ============================================================================

# 阿里云百炼 API-KEY（所有能力共用）
# 申请入口：百炼控制台 -> 右上角头像 -> API-KEY 管理
#   控制台：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 接口基址（一般无需修改）
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_COMPAT_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 视觉自检(omni)与TTS需走「业务空间专属 host」；在模型广场对应模型的
# API代码示例里复制，下面两个分别是 OpenAI兼容 base_url 与 HTTP /api/v1 基址
DASHSCOPE_OMNI_BASE=https://llm-bk62d2444ic30nz3.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TTS_BASE=https://llm-bk62d2444ic30nz3.cn-beijing.maas.aliyuncs.com/api/v1

# 1) 编排Agent + 编剧Agent：文本大模型，必须支持 Function Calling
#    常用：qwen3.8-flash（快）、qwen-plus（均衡）、qwen3.8-max（最强）
QWEN_MODEL=qwen3.8-flash

# 2) 画师自检：必须能「看图」的视觉模型（不是纯文本模型）
#    常用：qwen3.8-omni-flash（全模态、免费额度大，默认）、qwen-vl-max（准）
QWEN_VL_MODEL=qwen3.8-omni-flash

# 3) 文生图：图像生成模型（注意不是视频模型）
#    常用：qwen-image-3.0（均衡）、qwen-image-3.0-pro（最精）、wan2.7-image-pro
IMAGE_MODEL=qwen-image-3.0

# 4) 图生视频（异步任务；首帧自动上传百炼临时存储，48h 有效）
#    wan3.0-video：2~30s（标准版，有免费额度）
#    wan3.0-video-prime：2~30s（优速版，免费额度独立）
#    MiniMax/MiniMax-H3：4~15s（需先在模型广场点「立即开通」）
VIDEO_MODEL=wan3.0-video

# 5) 非实时配音
#    常用：qwen-audio-3.1-tts-flash（快）、cosyvoice-v2（稳）、cosyvoice-v3.5-flash（新）
TTS_MODEL=qwen-audio-3.1-tts-flash

# TTS 音色（qwen-audio-3.1 专属 v3.1 音色，完整列表见 MODELS.md）
TTS_VOICE_MALE=longanyang_v3.1     # 龙安洋：阳光大男孩
TTS_VOICE_FEMALE=longanhuan_v3.1   # 龙安欢：欢脱元气女
TTS_VOICE_NARRATOR=anmingyuan_v3.1 # 安明远：旁白

# ---------------------------------------------------------------------------
# 服务与可选参数
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# OUTPUT_DIR=
BGM_PATH=                    # 可选背景音乐，例如 D:/music/bgm.mp3

# 认证：生产环境务必改成随机字符串（例如 python -c "import secrets;print(secrets.token_hex(32))"）
JWT_SECRET=dev-only-secret-change-me-in-prod
# JWT_EXPIRE_HOURS=24

# 同时执行的生成任务数，超出的任务排队
MAX_CONCURRENT_TASKS=2
# 单个任务内同时生成的视频片段数（信号量限流，免费额度建议 2~3）
MAX_CONCURRENT_CLIPS=3
# 单个任务内同时生成的关键帧数（含自检重绘，免费额度建议 2~3）
MAX_CONCURRENT_KEYFRAMES=2
# 单个任务内剪辑阶段（归一化/TTS）并发数
MAX_CONCURRENT_EDITOR=3

TASK_POLL_TIMEOUT=900
TASK_POLL_INTERVAL=5
MAX_SHOTS=12
